// Paste the prepared private/Code.gs file into this spreadsheet's Apps Script editor.
// Never publish this source or the shared secret in the browser bundle.
var ERDENET_SHEET_ID = '1argV8PktHaKNvW5_iK0UICcwOkHGDJtEq__PwSOGs2k';
var ERDENET_TAB = 'Sheet1';
var ERDENET_SECRET = '__WEBHOOK_SECRET__';
var ERDENET_EVENT = 'erdenet-opening-2026-11';
var ERDENET_HEADERS = ['Бүртгэлийн ID', 'Бүртгэсэн огноо', 'Нэр', 'Утас', 'Эвент', 'Өдөр', 'Цаг', 'Эх сурвалж', 'UTM source', 'UTM campaign', 'Зөвшөөрөл', 'Бэлэг'];
// Mirrors PRIZES in public/lead-validation.js; the Sheet shows the label.
var ERDENET_PRIZES = { umbrella: 'Шүхэр', usb: 'USB багц', notebook: 'Хуванцар дугаар бичигч', gift: 'Дугаар бичигч', generalGift: 'Гарын бэлэг', none: 'Бэлэг олгогдоогүй' };
var ERDENET_STOCK = { umbrella: 50, usb: 25, notebook: 20, gift: 155, generalGift: 0 };
var ERDENET_TEST_IDS = ['9c4a6cb0-16ae-4c30-b539-f7f92a3443c5', 'fbdea9e6-01c6-4a01-9f4f-544de11b2bc3'];

function drawRemainingPrize(remaining) {
  var ids = Object.keys(ERDENET_STOCK);
  var total = ids.reduce(function(sum, id) { return sum + remaining[id]; }, 0);
  if (!total) return 'none';
  var position = Math.floor(Math.random() * total);
  for (var i = 0; i < ids.length; i++) {
    if (position < remaining[ids[i]]) return ids[i];
    position -= remaining[ids[i]];
  }
}

function jsonOutput(value) {
  return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON);
}

function doGet() { return jsonOutput({ ok: true, service: 'erdenet-test-drive', receiverVersion: 2 }); }

function hasWebhookSecret() { return /^[A-Za-z0-9_-]{32,}$/.test(ERDENET_SECRET); }

function hasLeadHeaders(headers) {
  var last = ERDENET_HEADERS.length - 1;
  return ERDENET_HEADERS.every(function(value, index) {
    return headers[index] === value || (index === last && String(headers[index] || '') === '');
  });
}

// Run in the Apps Script editor as the account that deploys the web app.
function verifyErdenetSheet() {
  if (!hasWebhookSecret()) throw new Error('Webhook secret is missing. Use the prepared private/Code.gs file.');
  var sheet = SpreadsheetApp.openById(ERDENET_SHEET_ID).getSheetByName(ERDENET_TAB);
  if (!sheet) throw new Error('The target spreadsheet has no Sheet1 tab.');
  var lastRow = sheet.getLastRow();
  if (lastRow > 0 && !hasLeadHeaders(sheet.getRange(1, 1, 1, ERDENET_HEADERS.length).getValues()[0])) {
    throw new Error('Sheet1 headers do not match the registration columns.');
  }
  var nextRow = Math.min(lastRow + 1, sheet.getMaxRows());
  if (!sheet.getRange(nextRow, 1, 1, ERDENET_HEADERS.length).canEdit()) {
    throw new Error('The deploying account needs edit permission on Sheet1.');
  }
  console.info('Erdenet receiver verified Sheet1 edit access.');
  return true;
}

function rejectLead(reason) {
  console.warn('Erdenet receiver: ' + reason);
  return jsonOutput({ ok: false });
}

function literalText(value) { return "'" + String(value || '').replace(/[\u0000-\u001f\u007f]/g, '').slice(0, 200); }

function doPost(e) {
  var lock;
  var stage = 'parse request';
  try {
    if (!e || !e.postData || e.postData.contents.length > 4096) return jsonOutput({ ok: false });
    var data = JSON.parse(e.postData.contents);
    if (!hasWebhookSecret()) return rejectLead('webhook secret not configured');
    if (!data || data.secret !== ERDENET_SECRET) return rejectLead('webhook secret mismatch');
    var uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
    if (typeof data.id !== 'string' || !uuid.test(data.id) || data.event !== ERDENET_EVENT || data.consent !== true || data.consentVersion !== 'erdenet-opening-v1') return jsonOutput({ ok: false });
    if (typeof data.name !== 'string' || data.name.trim().length < 2 || data.name.length > 80 || /[\u0000-\u001f\u007f]/.test(data.name)) return jsonOutput({ ok: false });
    if (typeof data.phone !== 'string' || !/^\+976\d{8}$/.test(data.phone)) return jsonOutput({ ok: false });
    var slots = { '2026-11-28': ['10:00', '12:00', '14:00', '16:00', '18:00'], '2026-11-29': ['17:00'] };
    if (!Object.prototype.hasOwnProperty.call(slots, data.day) || slots[data.day].indexOf(data.time) < 0) return jsonOutput({ ok: false });
    if (typeof data.prize !== 'string' || !Object.prototype.hasOwnProperty.call(ERDENET_PRIZES, data.prize)) return jsonOutput({ ok: false });
    if (!Number.isFinite(Date.parse(data.createdAt)) || !Number.isFinite(Date.parse(data.consentAt))) return jsonOutput({ ok: false });
    stage = 'acquire Sheet lock';
    lock = LockService.getScriptLock();
    if (!lock.tryLock(20000)) return rejectLead('Sheet lock timed out');
    stage = 'open Sheet1';
    var sheet = SpreadsheetApp.openById(ERDENET_SHEET_ID).getSheetByName(ERDENET_TAB);
    if (!sheet) return rejectLead('Sheet1 tab missing');
    stage = 'read Sheet1 headers';
    if (sheet.getLastRow() === 0) sheet.getRange(1, 1, 1, ERDENET_HEADERS.length).setValues([ERDENET_HEADERS]);
    var headers = sheet.getRange(1, 1, 1, ERDENET_HEADERS.length).getValues()[0];
    // A sheet prepared for the earlier event has 11 headers: add the prize column once.
    var last = ERDENET_HEADERS.length - 1;
    if (!hasLeadHeaders(headers)) return rejectLead('Sheet1 headers do not match');
    if (String(headers[last] || '') === '') {
      sheet.getRange(1, 1, 1, ERDENET_HEADERS.length).setValues([ERDENET_HEADERS]);
    }
    stage = 'check existing registrations';
    var lastRow = sheet.getLastRow();
    // The Sheet is the record of who won what: one prize per phone for the whole event.
    var prizeIds = {};
    Object.keys(ERDENET_PRIZES).forEach(function(key) { prizeIds[ERDENET_PRIZES[key]] = key; });
    // Awards written by the earlier deployment still consume their matching stock.
    prizeIds['Тэмдэглэлийн дэвтэр'] = 'notebook';
    prizeIds['Гарын бэлэг'] = 'gift';
    prizeIds['Борооны шүхэр'] = 'umbrella';
    var remaining = Object.assign({}, ERDENET_STOCK);
    var duplicatePhone = false;
    var labelsChanged = false;
    if (lastRow > 1) {
      var existing = sheet.getRange(2, 1, lastRow - 1, ERDENET_HEADERS.length).getValues();
      for (var i = 0; i < existing.length; i++) {
        var row = existing[i];
        var existingId = String(row[0]).replace(/^'/, '');
        var existingPhone = String(row[3]).replace(/^'/, '');
        var existingEvent = String(row[4]).replace(/^'/, '');
        var existingDay = String(row[5]).replace(/^'/, '');
        var existingTime = String(row[6]).replace(/^'/, '');
        var existingPrize = prizeIds[String(row[11]).replace(/^'/, '')] || '';
        if (existingId === data.id && (existingPhone !== data.phone || existingDay !== data.day || existingTime !== data.time || existingEvent !== ERDENET_EVENT)) return jsonOutput({ ok: false });
        var realEventLead = existingEvent === ERDENET_EVENT && ERDENET_TEST_IDS.indexOf(existingId) < 0;
        if (realEventLead && existingPrize && String(row[11]).replace(/^'/, '') !== ERDENET_PRIZES[existingPrize]) {
          sheet.getRange(i + 2, 12).setNumberFormat('@').setValues([[literalText(ERDENET_PRIZES[existingPrize])]]);
          labelsChanged = true;
        }
        if (existingId === data.id) {
          if (labelsChanged) SpreadsheetApp.flush();
          return jsonOutput({ ok: true, requestId: data.id, id: existingId, prize: existingPrize || 'none' });
        }
        if (existingPhone === data.phone && existingEvent === ERDENET_EVENT) duplicatePhone = true;
        if (realEventLead && Object.prototype.hasOwnProperty.call(remaining, existingPrize)) {
          remaining[existingPrize] = Math.max(0, remaining[existingPrize] - 1);
        }
      }
    }
    if (duplicatePhone) {
      if (labelsChanged) SpreadsheetApp.flush();
      return jsonOutput({ ok: true, requestId: data.id, duplicate: true });
    }
    stage = 'write registration to Sheet1';
    var prize = ERDENET_TEST_IDS.indexOf(data.id) >= 0 ? 'none' : drawRemainingPrize(remaining);
    var createdAt = Utilities.formatDate(new Date(data.createdAt), 'Asia/Ulaanbaatar', 'yyyy-MM-dd HH:mm:ss');
    var consentAt = Utilities.formatDate(new Date(data.consentAt), 'Asia/Ulaanbaatar', 'yyyy-MM-dd HH:mm:ss');
    var values = [data.id, createdAt, data.name.trim(), data.phone, ERDENET_EVENT, data.day, data.time, 'erdenet-web', data.utmSource || '', data.utmCampaign || '', consentAt + ' / ' + data.consentVersion, ERDENET_PRIZES[prize]];
    if (lastRow + 1 > sheet.getMaxRows()) sheet.insertRowsAfter(sheet.getMaxRows(), 1000);
    sheet.getRange(lastRow + 1, 1, 1, values.length).setNumberFormat('@').setValues([values.map(literalText)]);
    SpreadsheetApp.flush();
    return jsonOutput({ ok: true, requestId: data.id, id: data.id, prize: prize });
  } catch (error) {
    return rejectLead('could not ' + stage);
  } finally {
    if (lock && lock.hasLock && lock.hasLock()) lock.releaseLock();
    else if (lock && !lock.hasLock) lock.releaseLock();
  }
}
